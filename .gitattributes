# A Makefile needs LF line endings: with CRLF (what Git on Windows would write in the working
# copy) `make` fails on the carriage return at the end of every line.
Makefile text eol=lf

# terraform fmt writes LF; with CRLF `terraform fmt -check` would fail.
*.tf text eol=lf
*.tfvars.example text eol=lf
# The script of the instance runs on Linux: with CRLF, bash fails on the carriage return.
*.tftpl text eol=lf
infra/modules/compute/files/* text eol=lf
