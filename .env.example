# Copy this file to .env and adjust the values: cp .env.example .env
# The .env file is ignored by Git and must never contain real credentials in the repository.

# The services' DATABASE_URL is not set here: compose.yaml builds it from the three variables below.
# DATABASE_SCHEMA and REDIS_URL are fixed in compose.yaml as well, as they are the same for everyone.

POSTGRES_USER=verifactu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=verifactu

# Simulated AEAT (submission-service). Optional: the values below are the defaults.
#   AEAT_SIMULATION: accept (every submission is accepted), reject, fail (the AEAT is always down,
#   so the submission ends FAILED) or flaky (each attempt fails with probability AEAT_FAILURE_RATE).
# A failed attempt is retried waiting SUBMISSION_RETRY_BASE_SECONDS, then twice as long each time,
# up to SUBMISSION_MAX_ATTEMPTS attempts.
# AEAT_SIMULATION=accept
# AEAT_FAILURE_RATE=0.5
# SUBMISSION_MAX_ATTEMPTS=5
# SUBMISSION_RETRY_BASE_SECONDS=5
